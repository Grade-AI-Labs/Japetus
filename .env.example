# Copy to .env.local and fill in. .env.local is gitignored.

# Server
PORT=3333
# Filesystem adapter root. Default points at the dev/test fixture corpus.
# Production deployments use REGISTRY_CONFIG=config/registry.production.json
# (Confluence-backed) and never read this directory.
CONTENT_DIR=./config/fixtures/content
# MVP stub for who_owns; replaced by a real catalog source per issue 33.
CATALOG_FILE=./catalog/services.json
# Path to the registry config (URI → adapter + backing-id mapping).
# Default: config/registry.dev.json (filesystem adapter, dev fixtures).
# Production: point at config/registry.production.json once issue 30 lands real Confluence page IDs.
REGISTRY_CONFIG=config/registry.dev.json

# Auth. Options: dev (all scopes, NO token validation), entra (real validation), off (no auth).
# Use "dev" only locally. Never in any environment with real data.
AUTH_MODE=dev

# Entra (required when AUTH_MODE=entra)
ENTRA_TENANT_ID=
ENTRA_AUDIENCE=api://japetus

# Confluence adapter (optional; absent => filesystem-only)
CONFLUENCE_BASE_URL=
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
CONFLUENCE_SPACE_ENG=ENG
CONFLUENCE_SPACE_PRODUCT=PRODUCT
CONFLUENCE_SPACE_SEC=SEC

# Staleness dashboard. Omit to disable; set to a port to enable on http://localhost:$PORT/
STALENESS_PORT=

# Audit sinks. Stdout is always on; the others activate only when their env var is set.
# AppSignal — operational dashboards, error grouping.
APPSIGNAL_PUSH_API_KEY=
APPSIGNAL_APP_NAME=japetus
# OpenTelemetry — meter export. Standard OTEL_EXPORTER_OTLP_* env vars are honoured.
OTEL_EXPORTER_OTLP_ENDPOINT=
