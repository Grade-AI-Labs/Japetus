# Copy to .env.local and fill in. .env.local is gitignored.

# Server
PORT=3333
CONTENT_DIR=./content
CATALOG_FILE=./catalog/services.json

# Auth. Options: dev (all scopes, NO token validation), entra (real validation), off (no auth).
# Use "dev" only locally. Never in any environment with real data.
AUTH_MODE=dev

# Entra (required when AUTH_MODE=entra)
ENTRA_TENANT_ID=
ENTRA_AUDIENCE=api://talentech-standards

# Confluence adapter (optional; absent => filesystem-only)
CONFLUENCE_BASE_URL=
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
CONFLUENCE_SPACE_ENG=ENG
CONFLUENCE_SPACE_PRODUCT=PRODUCT
CONFLUENCE_SPACE_SEC=SEC

# Staleness dashboard. Omit to disable; set to a port to enable on http://localhost:$PORT/
STALENESS_PORT=
